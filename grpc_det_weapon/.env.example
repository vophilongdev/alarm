# gRPC
PORT_HOST=50062
GRPC_PORT=50061

# Inference
USE_TENSORRT=true
CONF_THRESHOLD=0.3
BATCH_SIZE=8
BATCH_TIMEOUT_MS=10

# Class mapping (dùng khi model đặt tên placeholder '0'..'6')
# CLASS_NAMES=0:person,1:dao,2:sung_ngan,3:sung_truong,4:keo,5:gay,6:bom

# Mask overlap — phân loại class Người vs Vũ khí
PERSON_CLASS_IDS=0
WEAPON_CLASS_IDS=1,2,3,4,5,6
DILATION_KERNEL_SIZE=5
MIN_OVERLAP_PIXELS=15
MIN_OVERLAP_RATIO=0.05

# CMS
BASE_URL_API=https://api-dev.tado.vn
SESSION_KEY=

# Camera license
SERVICE_TYPE=weapon,weapon_detection
POLL_INTERVAL=20

# Alarm
ALARM_TYPE=weapon
ALARM_SOURCE=grpc_det_weapon
ALARM_COOLDOWN=10
JPEG_QUALITY=60
