# Copy sang .env rồi điền giá trị thật. File .env không commit.

# CMS
BASE_URL_API=https://api-dev.tado.vn
SESSION_KEY=

# Cổng license: service chỉ phục vụ camera khởi tạo với service_type này
# và có license_key. Đổi cho khớp service_type trong license.
SERVICE_TYPE=encroach
POLL_INTERVAL=20

# Lấn chiếm trong ROI quá DWELL_SECONDS giây thì bắn alarm
DWELL_SECONDS=10
ALARM_COOLDOWN=60
ALARM_TYPE=encroach
ALARM_SOURCE=grpc_det_encroach
JPEG_QUALITY=60

# Inference
USE_TENSORRT=true
CONF_THRESHOLD=0.35
BATCH_SIZE=8
BATCH_TIMEOUT_MS=10

# Nhãn thật của best.pt, ví dụ: 0:xe_may,1:hang_hoa. Bỏ trống = obj_0..obj_9
CLASS_NAMES=
